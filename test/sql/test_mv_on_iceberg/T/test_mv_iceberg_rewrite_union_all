-- name: test_mv_iceberg_rewrite_union_all
-- Test Point: MV that UNION ALLs two Iceberg tables supports rewrite of
--             the same union query; incremental insert into either side
--             propagates correctly after refresh.
-- Method: two Iceberg bases (orders_a, orders_b); MV = orders_a UNION ALL
--         orders_b; probe identical + reordered-branch union; INSERT into
--         each side + refresh + probe.
-- Scope: UNION ALL Iceberg MV rewrite (M8-7).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};

CREATE TABLE orders_a (order_id int, dt date, amount bigint) PARTITION BY (dt);
INSERT INTO orders_a VALUES (1, '2024-01-01', 10), (2, '2024-01-02', 20);

CREATE TABLE orders_b (order_id int, dt date, amount bigint) PARTITION BY (dt);
INSERT INTO orders_b VALUES (3, '2024-01-01', 5), (4, '2024-01-02', 7);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

CREATE MATERIALIZED VIEW mv_union
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS
  SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a
  UNION ALL
  SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b;
[UC]REFRESH MATERIALIZED VIEW mv_union WITH SYNC MODE;

SELECT order_id, dt, amount FROM mv_union ORDER BY order_id;

-- Identical probe
function: print_hit_materialized_view("SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a UNION ALL SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b", "mv_union")

-- Reordered branches (b UNION ALL a) — lock behavior
function: print_hit_materialized_view("SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b UNION ALL SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a", "mv_union")

-- INSERT into orders_a + refresh
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a VALUES (5, '2024-01-03', 30);
[UC]REFRESH MATERIALIZED VIEW mv_union WITH SYNC MODE;
SELECT order_id, dt, amount FROM mv_union ORDER BY order_id;
function: print_hit_materialized_view("SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a UNION ALL SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b", "mv_union")

-- INSERT into orders_b + refresh
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b VALUES (6, '2024-01-03', 100);
[UC]REFRESH MATERIALIZED VIEW mv_union WITH SYNC MODE;
SELECT order_id, dt, amount FROM mv_union ORDER BY order_id;
function: print_hit_materialized_view("SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a UNION ALL SELECT order_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b", "mv_union")

drop materialized view mv_union;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_a force;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders_b force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
