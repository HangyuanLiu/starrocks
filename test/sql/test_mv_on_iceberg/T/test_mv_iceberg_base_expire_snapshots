-- name: test_mv_iceberg_base_expire_snapshots @slow
-- Test Point: After `alter table execute expire_snapshots(now())` on an
--             Iceberg base, MV refresh + rewrite continue to work; FE
--             does not stumble on the reduced snapshot history.
-- Method: build base, insert multiple snapshots, create and refresh MV,
--         execute expire_snapshots, refresh again, verify row counts and
--         rewrite hit.
-- Scope: Iceberg expire_snapshots × MV (M5-2).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};
CREATE TABLE t1 (id int, dt date, val int) PARTITION BY (dt);
INSERT INTO t1 VALUES (1, '2024-01-01', 10);
INSERT INTO t1 VALUES (2, '2024-01-02', 20);
INSERT INTO t1 VALUES (3, '2024-01-03', 30);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

CREATE MATERIALIZED VIEW test_mv1
PARTITION BY dt
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT dt, sum(val) as sv
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1
   GROUP BY dt;
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;

-- Baseline
SELECT IS_ACTIVE FROM information_schema.materialized_views
  WHERE table_name = 'test_mv1' AND table_schema = 'db_${uuid0}';
SELECT dt, sv FROM test_mv1 ORDER BY dt;
function: print_hit_materialized_view("SELECT dt, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt", "test_mv1")

-- Expire all old snapshots (older_than=now() expires everything except the current snapshot)
alter table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 execute expire_snapshots(older_than=now());
select sleep(2);
refresh external table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1;

-- Post-expire state probes
SELECT IS_ACTIVE FROM information_schema.materialized_views
  WHERE table_name = 'test_mv1' AND table_schema = 'db_${uuid0}';
SELECT dt, sv FROM test_mv1 ORDER BY dt;
function: print_hit_materialized_view("SELECT dt, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt", "test_mv1")

-- New insert + refresh still works
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 VALUES (4, '2024-01-04', 40);
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;
SELECT dt, sv FROM test_mv1 ORDER BY dt;
function: print_hit_materialized_view("SELECT dt, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt", "test_mv1")

drop materialized view test_mv1;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
