-- name: test_mv_iceberg_rewrite_semi_anti_join
-- Test Point: MV precomputing LEFT SEMI / LEFT ANTI JOIN between two
--             Iceberg tables supports rewrite for SEMI/ANTI, EXISTS, and
--             NOT EXISTS query forms.
-- Method: two Iceberg bases (orders/customers); MV for SEMI (orders that
--         have matching customer); MV for ANTI (orders without matching);
--         probe rewrite via each semantic form.
-- Scope: SEMI / ANTI join Iceberg MV rewrite (M8-5).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};

CREATE TABLE orders (
  order_id int,
  customer_id int,
  dt date,
  amount bigint
) PARTITION BY (dt);
INSERT INTO orders VALUES
  (1, 100, '2024-01-01', 50),
  (2, 101, '2024-01-01', 30),
  (3, 999, '2024-01-02', 80),
  (4, 102, '2024-01-02', 20);

CREATE TABLE customers (
  customer_id int,
  name string
);
INSERT INTO customers VALUES
  (100, 'alice'),
  (101, 'bob'),
  (102, 'carol');

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

-- SEMI: orders with matching customer
CREATE MATERIALIZED VIEW mv_semi
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT o.order_id, o.customer_id, o.dt, o.amount
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
   LEFT SEMI JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
     ON o.customer_id = c.customer_id;
[UC]REFRESH MATERIALIZED VIEW mv_semi WITH SYNC MODE;

-- ANTI: orders without matching customer
CREATE MATERIALIZED VIEW mv_anti
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT o.order_id, o.customer_id, o.dt, o.amount
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
   LEFT ANTI JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
     ON o.customer_id = c.customer_id;
[UC]REFRESH MATERIALIZED VIEW mv_anti WITH SYNC MODE;

-- Baseline
SELECT order_id, customer_id, dt, amount FROM mv_semi ORDER BY order_id;
SELECT order_id, customer_id, dt, amount FROM mv_anti ORDER BY order_id;

-- Identical SEMI probe
function: print_hit_materialized_view("SELECT o.order_id, o.customer_id, o.dt, o.amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o LEFT SEMI JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id", "mv_semi")

-- EXISTS form (should equiv to SEMI)
function: print_hit_materialized_view("SELECT order_id, customer_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o WHERE EXISTS (SELECT 1 FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c WHERE o.customer_id = c.customer_id)", "mv_semi")

-- Identical ANTI probe
function: print_hit_materialized_view("SELECT o.order_id, o.customer_id, o.dt, o.amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o LEFT ANTI JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id", "mv_anti")

-- NOT EXISTS form (should equiv to ANTI)
function: print_hit_materialized_view("SELECT order_id, customer_id, dt, amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o WHERE NOT EXISTS (SELECT 1 FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c WHERE o.customer_id = c.customer_id)", "mv_anti")

drop materialized view mv_semi;
drop materialized view mv_anti;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders force;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
