drop materialized view test_mv1;
drop database default_catalog.db_${uuid0} force;
drop table mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0}.t1 force;
drop database mv_iceberg_${uuid0}.mv_iceberg_db_${uuid0} force;
