-- name: test_alter_mv_property_refresh_iceberg
-- Test Point: ALTER MATERIALIZED VIEW ... SET ("<prop>"="<v>") on an Iceberg
--             -backed MV persists refresh properties and query-rewrite
--             consistency mode, and the modified strategy still refreshes.
-- Method: create MV with defaults, snapshot properties, flip a series of
--         properties one by one, re-snapshot and diff, then run a refresh to
--         confirm the modified strategy still executes.
-- Scope: ALTER MV PROPERTIES lifecycle for Iceberg-backed MVs (M1-2).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};
CREATE TABLE t1 (id int, dt date, val int) PARTITION BY (dt);
INSERT INTO t1 VALUES (1, '2024-01-01', 10), (2, '2024-01-02', 20);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

CREATE MATERIALIZED VIEW test_mv1
PARTITION BY dt
REFRESH ASYNC EVERY(INTERVAL 1 DAY)
PROPERTIES (
  "replication_num" = "1",
  "query_rewrite_consistency" = "loose"
)
AS SELECT id, dt, val FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1;
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;

-- Baseline
SHOW CREATE MATERIALIZED VIEW test_mv1;

-- Flip excluded_trigger_tables
ALTER MATERIALIZED VIEW test_mv1 SET (
  "excluded_trigger_tables" = "mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1"
);
SHOW CREATE MATERIALIZED VIEW test_mv1;

-- Flip query_rewrite_consistency
ALTER MATERIALIZED VIEW test_mv1 SET ("query_rewrite_consistency" = "checked");
SHOW CREATE MATERIALIZED VIEW test_mv1;

-- Flip auto_refresh_partitions_limit
ALTER MATERIALIZED VIEW test_mv1 SET ("auto_refresh_partitions_limit" = "3");
SHOW CREATE MATERIALIZED VIEW test_mv1;

-- Refresh after property changes still works
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 VALUES (3, '2024-01-03', 30);
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;
SELECT id, dt, val FROM test_mv1 ORDER BY id;

drop materialized view test_mv1;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
