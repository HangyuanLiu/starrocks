-- name: test_mv_with_iceberg_transform_force_mv_local
-- Test Point: verify partition_retention_condition with FORCE_MV on a self-built day-transform iceberg table.
-- Queries on both retained and pruned ranges should still explain through the mv under FORCE_MV,
-- while mv contents only keep partitions allowed by the retention condition.

function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")
set catalog mv_iceberg_${uuid0};
create database sql_test_db_${uuid0};
use sql_test_db_${uuid0};

CREATE TABLE test_iceberg_with_days (
  id int,
  region string,
  state string,
  shipdate datetime
)
PARTITION BY day(shipdate), region, state;
INSERT INTO test_iceberg_with_days VALUES
  (1, 'beijing', 'N', '2024-11-12 00:00:00'),
  (2, 'guangdong', 'R', '2024-11-13 00:00:00'),
  (3, 'shanghai', 'A', '2024-11-14 00:00:00');

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};

CREATE MATERIALIZED VIEW test_days_force
PARTITION BY (region, state, date_trunc('day', shipdate))
REFRESH DEFERRED MANUAL
PROPERTIES (
  "replication_num" = "1",
  "partition_retention_condition" = "date_trunc('day', shipdate) >= '2024-11-13' or date_trunc('day', shipdate) is null",
  "query_rewrite_consistency" = "force_mv"
)
AS
  SELECT * FROM mv_iceberg_${uuid0}.sql_test_db_${uuid0}.test_iceberg_with_days;
[UC]REFRESH MATERIALIZED VIEW test_days_force WITH SYNC MODE;

function: print_hit_materialized_view("SELECT id, region, state, shipdate FROM mv_iceberg_${uuid0}.sql_test_db_${uuid0}.test_iceberg_with_days where shipdate >= '2024-11-13 00:00:00' order by id;", "test_days_force")
function: print_hit_materialized_view("SELECT id, region, state, shipdate FROM mv_iceberg_${uuid0}.sql_test_db_${uuid0}.test_iceberg_with_days where shipdate < '2024-11-13 00:00:00' order by id;", "test_days_force")
SELECT count(*) FROM test_days_force;
SELECT * FROM test_days_force order by id;

DROP MATERIALIZED VIEW test_days_force;
drop database db_${uuid0} force;
drop table mv_iceberg_${uuid0}.sql_test_db_${uuid0}.test_iceberg_with_days;
drop database mv_iceberg_${uuid0}.sql_test_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
