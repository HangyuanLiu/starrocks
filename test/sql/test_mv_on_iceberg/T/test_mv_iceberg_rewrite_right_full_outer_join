-- name: test_mv_iceberg_rewrite_right_full_outer_join
-- Test Point: MV pre-computing a RIGHT OUTER JOIN or FULL OUTER JOIN of
--             two Iceberg tables produces correct NULL padding on the
--             non-matching side, and rewrite preserves that behavior
--             including IS NULL / IS NOT NULL filters.
-- Method: one MV with RIGHT OUTER JOIN, one with FULL OUTER JOIN;
--         each probed for identical-query + IS NULL filter hit + row
--         correctness.
-- Scope: RIGHT / FULL OUTER JOIN Iceberg MV rewrite (M8-4).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};

CREATE TABLE orders (
  order_id int,
  customer_id int,
  dt date,
  amount bigint
) PARTITION BY (dt);
INSERT INTO orders VALUES
  (1, 100, '2024-01-01', 50),
  (2, 101, '2024-01-01', 30),
  (3, 999, '2024-01-02', 80);  -- orphan order (no matching customer)

CREATE TABLE customers (
  customer_id int,
  name string,
  region string
);
INSERT INTO customers VALUES
  (100, 'alice', 'cn'),
  (101, 'bob', 'us'),
  (102, 'carol', 'jp');  -- orphan customer (no orders)

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

-- RIGHT OUTER JOIN MV
CREATE MATERIALIZED VIEW mv_roj
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT o.order_id, o.dt, o.amount, c.customer_id, c.name, c.region
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
   RIGHT OUTER JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
     ON o.customer_id = c.customer_id;
[UC]REFRESH MATERIALIZED VIEW mv_roj WITH SYNC MODE;

-- FULL OUTER JOIN MV
CREATE MATERIALIZED VIEW mv_foj
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT o.order_id, o.dt, o.amount, c.customer_id, c.name, c.region
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
   FULL OUTER JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
     ON o.customer_id = c.customer_id;
[UC]REFRESH MATERIALIZED VIEW mv_foj WITH SYNC MODE;

-- Baseline MV content
SELECT order_id, dt, amount, customer_id, name, region FROM mv_roj ORDER BY customer_id, order_id;
SELECT order_id, dt, amount, customer_id, name, region FROM mv_foj ORDER BY customer_id, order_id;

-- Identical-query probes
function: print_hit_materialized_view("SELECT o.order_id, o.dt, o.amount, c.customer_id, c.name, c.region FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o RIGHT OUTER JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id", "mv_roj")
function: print_hit_materialized_view("SELECT o.order_id, o.dt, o.amount, c.customer_id, c.name, c.region FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o FULL OUTER JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id", "mv_foj")

-- IS NULL filter on orders side (for ROJ right-unmatched rows)
function: print_hit_materialized_view("SELECT c.customer_id, c.name FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o RIGHT OUTER JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id WHERE o.order_id IS NULL", "mv_roj")

-- IS NULL filter on customers side (FOJ picks up left-unmatched)
function: print_hit_materialized_view("SELECT o.order_id, o.amount FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o FULL OUTER JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id WHERE c.customer_id IS NULL", "mv_foj")

drop materialized view mv_roj;
drop materialized view mv_foj;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders force;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
