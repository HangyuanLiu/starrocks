-- name: test_mv_iceberg_add_partition_field
-- Test Point: ALTER TABLE ... ADD PARTITION COLUMN on an Iceberg base table
--             after the MV is created — verify MV still refreshes, schema is
--             unchanged, and data correctness holds for rows before and
--             after the partition-spec evolution.
-- Method: build unpartitioned Iceberg base; create partitioned MV;
--         insert/refresh; ADD PARTITION COLUMN month(dt); insert new rows;
--         refresh MV; assert row count and correctness; lock IS_ACTIVE.
-- Scope: Iceberg partition evolution (ADD) × MV (M3-1).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};
CREATE TABLE t1 (id int, dt date, val int);
INSERT INTO t1 VALUES
  (1, '2024-01-03', 10),
  (2, '2024-01-15', 20),
  (3, '2024-02-05', 30);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

-- MV partitioned by month over unpartitioned base
CREATE MATERIALIZED VIEW test_mv1
PARTITION BY (date_trunc('month', dt))
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT id, dt, val FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1;
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;

SELECT IS_ACTIVE FROM information_schema.materialized_views
  WHERE table_name = 'test_mv1' AND table_schema = 'db_${uuid0}';
SELECT count(*) FROM test_mv1;
SELECT id, dt, val FROM test_mv1 ORDER BY id;
function: print_hit_materialized_view("SELECT id, dt, val FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 ORDER BY id", "test_mv1")

-- ADD partition column on base (evolve from unpartitioned to month-partitioned)
alter table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 add partition column month(dt);

-- Insert new rows after partition-spec evolution
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 VALUES
  (4, '2024-03-10', 40),
  (5, '2024-03-25', 50);

-- Lock IS_ACTIVE after evolution
SELECT IS_ACTIVE FROM information_schema.materialized_views
  WHERE table_name = 'test_mv1' AND table_schema = 'db_${uuid0}';

-- Refresh should still succeed (or lock actual behavior if not)
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;
SELECT count(*) FROM test_mv1;
SELECT id, dt, val FROM test_mv1 ORDER BY id;
function: print_hit_materialized_view("SELECT id, dt, val FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 ORDER BY id", "test_mv1")

-- Cleanup
drop materialized view test_mv1;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
