-- name: test_mv_iceberg_rewrite_single_table_agg
-- Test Point: Single-table Iceberg MV with multi-aggregate
--             (sum/avg/count/count-distinct/min/max) supports rewrite hit
--             for each aggregate form; correctness under incremental
--             insert.
-- Method: MV with comprehensive aggregate list; 6 individual probes; INSERT
--         + refresh; probe one form again.
-- Scope: Single-table multi-aggregate rewrite (M8-1).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};
CREATE TABLE t1 (id int, dt date, region string, val int) PARTITION BY (dt);
INSERT INTO t1 VALUES
  (1, '2024-01-01', 'cn', 10),
  (2, '2024-01-01', 'cn', 20),
  (3, '2024-01-02', 'cn', 30),
  (4, '2024-01-01', 'us', 5),
  (5, '2024-01-02', 'us', 7);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

CREATE MATERIALIZED VIEW test_mv1
PARTITION BY dt
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT dt, region,
       sum(val) as s_val,
       count(val) as c_val,
       count(distinct id) as c_id,
       min(val) as min_val,
       max(val) as max_val,
       avg(val) as a_val
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1
   GROUP BY dt, region;
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;

-- Baseline
SELECT dt, region, s_val, c_val, c_id, min_val, max_val, a_val FROM test_mv1 ORDER BY dt, region;

-- Probes for each aggregate
function: print_hit_materialized_view("SELECT dt, region, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")
function: print_hit_materialized_view("SELECT dt, region, count(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")
function: print_hit_materialized_view("SELECT dt, region, count(distinct id) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")
function: print_hit_materialized_view("SELECT dt, region, min(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")
function: print_hit_materialized_view("SELECT dt, region, max(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")
function: print_hit_materialized_view("SELECT dt, region, avg(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")

-- Incremental insert
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 VALUES (6, '2024-01-02', 'cn', 40);
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;

SELECT dt, region, s_val, c_val, c_id, min_val, max_val, a_val FROM test_mv1 ORDER BY dt, region;
function: print_hit_materialized_view("SELECT dt, region, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt, region", "test_mv1")

drop materialized view test_mv1;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
