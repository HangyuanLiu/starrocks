-- name: test_mv_iceberg_rewrite_inner_join_2tbl
-- Test Point: MV pre-computing an INNER JOIN of two Iceberg tables hits
--             the rewrite path for the same join, equivalent queries with
--             additional predicates, and after an incremental INSERT into
--             one of the bases + refresh.
-- Method: build two Iceberg tables with a shared key; create an MV joining
--         them; probe rewrite hit + row correctness for (identical query,
--         predicate-restricted query); insert into one base, refresh,
--         repeat probes.
-- Scope: INNER JOIN of two Iceberg bases × MV rewrite (M8-2).
function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};

CREATE TABLE orders (
  order_id int,
  customer_id int,
  dt date,
  amount bigint
) PARTITION BY (dt);
INSERT INTO orders VALUES
  (1, 100, '2024-01-01', 50),
  (2, 101, '2024-01-01', 30),
  (3, 100, '2024-01-02', 80),
  (4, 102, '2024-01-02', 20);

CREATE TABLE customers (
  customer_id int,
  name string,
  region string
);
INSERT INTO customers VALUES
  (100, 'alice', 'cn'),
  (101, 'bob', 'us'),
  (102, 'carol', 'jp');

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

CREATE MATERIALIZED VIEW mv_join
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT o.order_id, o.dt, o.amount, c.name, c.region
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
   JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
     ON o.customer_id = c.customer_id;
[UC]REFRESH MATERIALIZED VIEW mv_join WITH SYNC MODE;

-- Baseline MV contents
SELECT order_id, dt, amount, name, region FROM mv_join ORDER BY order_id;

-- Identical query -> should hit
SELECT o.order_id, o.dt, o.amount, c.name, c.region
  FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
  JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
    ON o.customer_id = c.customer_id
  ORDER BY o.order_id;
function: print_hit_materialized_view("SELECT o.order_id, o.dt, o.amount, c.name, c.region FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id", "mv_join")

-- Predicate on orders side (dt) -> should hit
SELECT o.order_id, o.dt, o.amount, c.name
  FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
  JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
    ON o.customer_id = c.customer_id
  WHERE o.dt = '2024-01-01'
  ORDER BY o.order_id;
function: print_hit_materialized_view("SELECT o.order_id, o.dt, o.amount, c.name FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id WHERE o.dt = '2024-01-01'", "mv_join")

-- Predicate on customers side (region) -> should hit
SELECT o.order_id, o.amount, c.name
  FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
  JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
    ON o.customer_id = c.customer_id
  WHERE c.region = 'cn'
  ORDER BY o.order_id;
function: print_hit_materialized_view("SELECT o.order_id, o.amount, c.name FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id WHERE c.region = 'cn'", "mv_join")

-- Incremental insert on orders side
INSERT INTO mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders VALUES (5, 100, '2024-01-03', 200);
[UC]REFRESH MATERIALIZED VIEW mv_join WITH SYNC MODE;
SELECT order_id, dt, amount, name, region FROM mv_join ORDER BY order_id;
function: print_hit_materialized_view("SELECT o.order_id, o.dt, o.amount, c.name, c.region FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c ON o.customer_id = c.customer_id", "mv_join")

drop materialized view mv_join;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders force;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};
