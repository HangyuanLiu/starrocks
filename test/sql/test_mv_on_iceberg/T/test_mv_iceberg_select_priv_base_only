-- name: test_mv_iceberg_select_priv_base_only
-- Test Point: User with SELECT on the Iceberg base only (no SELECT on MV)
--             can query the base directly; MV query is denied; rewrite
--             does not silently bypass the missing MV SELECT.
-- Method: admin creates MV + base; create limited user with base SELECT
--         (but not MV); EXECUTE AS user; query base (OK); query MV
--         (denied); probe rewrite via base query (does NOT silently
--         use MV, returns direct base result).
-- Scope: Reverse-direction RBAC — user has base but not MV (M11-1).

admin set frontend config('enable_mv_automatic_active_check'='false');

function: create_iceberg_catalog("mv_iceberg_${uuid0}", "${iceberg_sql_test_catalog_type}")

set catalog mv_iceberg_${uuid0};
create database mv_ice_db_${uuid0};
use mv_ice_db_${uuid0};
CREATE TABLE t1 (id int, dt date, val int) PARTITION BY (dt);
INSERT INTO t1 VALUES (1, '2024-01-01', 10), (2, '2024-01-02', 20);

set catalog default_catalog;
create database db_${uuid0};
use db_${uuid0};
set new_planner_optimize_timeout=10000;

CREATE MATERIALIZED VIEW test_mv1
PARTITION BY dt
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT dt, sum(val) as sv
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1
   GROUP BY dt;
[UC]REFRESH MATERIALIZED VIEW test_mv1 WITH SYNC MODE;

-- Create limited user
DROP USER IF EXISTS test_base_ro_${uuid0};
CREATE USER test_base_ro_${uuid0} IDENTIFIED BY 'pass';
GRANT USAGE ON CATALOG mv_iceberg_${uuid0} TO test_base_ro_${uuid0};
-- Switch to iceberg catalog context for GRANT on external table
set catalog mv_iceberg_${uuid0};
GRANT SELECT ON ALL TABLES IN DATABASE mv_ice_db_${uuid0} TO test_base_ro_${uuid0};
set catalog default_catalog;
use db_${uuid0};
GRANT IMPERSONATE ON USER root TO test_base_ro_${uuid0};

EXECUTE AS test_base_ro_${uuid0} WITH NO REVERT;

-- As user: direct base query — should succeed
SELECT dt, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt ORDER BY dt;

-- As user: direct MV query — should be denied
[UC]SELECT dt, sv FROM default_catalog.db_${uuid0}.test_mv1 ORDER BY dt;

-- As user: rewrite probe on a base-level query — should not silently hit MV
function: print_hit_materialized_view("SELECT dt, sum(val) FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 GROUP BY dt", "test_mv1")

EXECUTE AS root WITH NO REVERT;

-- Cleanup
REVOKE IMPERSONATE ON USER root FROM test_base_ro_${uuid0};
set catalog mv_iceberg_${uuid0};
REVOKE SELECT ON ALL TABLES IN DATABASE mv_ice_db_${uuid0} FROM test_base_ro_${uuid0};
set catalog default_catalog;
REVOKE USAGE ON CATALOG mv_iceberg_${uuid0} FROM test_base_ro_${uuid0};
DROP USER test_base_ro_${uuid0};

drop materialized view db_${uuid0}.test_mv1;
drop table mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.t1 force;
drop database default_catalog.db_${uuid0} force;
drop database mv_iceberg_${uuid0}.mv_ice_db_${uuid0} force;
drop catalog mv_iceberg_${uuid0};

admin set frontend config('enable_mv_automatic_active_check'='true');
