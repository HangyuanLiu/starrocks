CREATE MATERIALIZED VIEW mv_anti
REFRESH DEFERRED MANUAL
PROPERTIES ("replication_num" = "1")
AS SELECT o.order_id, o.customer_id, o.dt, o.amount
   FROM mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.orders o
   LEFT ANTI JOIN mv_iceberg_${uuid0}.mv_ice_db_${uuid0}.customers c
     ON o.customer_id = c.customer_id;
